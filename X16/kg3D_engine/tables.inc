
; code stuff
; these are values from linker config
; all reads are sector (512B) based
; = every size has to be divisible by 512

;;;;;;;;;;;;;;;
;;;;;;;;; $0000
; zero page
;;;;;;;;; $0100
; stack
;;;;;;;;; $0200
; kernal
;;;;;;;;; $0400
; tables T0
;;;;;;;;; $2500
; temp data
;;;;;;;;; $2900
; remap table
;;;;;;;;; $2A00
; light tables
;;;;;;;;; $3100
; swappable code
;;;;;;;;; $5700
; engine code
;;;;;;;;; $9F00
; IO
;;;;;;;;; $A000
;;;;;;;;;;;;;;;

