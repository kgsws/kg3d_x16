; zero page
;;;;;;;;; $0100
; stack
;;;;;;;;; $0200
; kernal
;;;;;;;;; $0400
; tables T0
;;;;;;;;; $2500
; temp data
;;;;;;;;; $2900
; light tables
;;;;;;;;; $3100
; swappable code
;;;;;;;;; $5700
; engine code
;;;;;;;;; $9F00
; IO
;;;;;;;;; $A000
;;;;;;;;;;;;;;;

