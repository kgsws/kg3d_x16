; VRAM cache
; this is inside TABLES0
; actual indexing is offset from zero
; harcoded 37 slots
; each slot represents 2k VRAM block

TAB_VCACHE_FIRST_BLOCK = 20
TAB_VCACHE_STOP_BLOCK = TAB_VCACHE_FIRST_BLOCK + 37

TAB_VCACHE_PREV = $07A0 - TAB_VCACHE_FIRST_BLOCK
TAB_VCACHE_NEXT = $07C5 - TAB_VCACHE_FIRST_BLOCK
TAB_VCACHE_TEX = $06A0 - TAB_VCACHE_FIRST_BLOCK
TAB_VCACHE_SLT = $06C5 - TAB_VCACHE_FIRST_BLOCK

